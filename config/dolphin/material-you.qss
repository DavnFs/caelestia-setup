/* ===================================================================
 * Material You 3 (M3) Official Specifications for KDE Dolphin
 * Reference: https://m3.material.io/
 * - Type Scale: Google Sans Flex (11.5pt Body, 500 Medium)
 * - Navigation Drawer: 48dp item height, 24dp pill indicator
 * - Top App Bar: 64dp surface, 40dp circular icon buttons
 * - Search Bar Pill: 44dp height, 24dp bubble radius
 * - Item Cards: 16dp rounded bubbles, no wireframe lines
 * - Tonal Hierarchy: Surface (#141317) -> Container (#1c1b1f / #211f26)
 * =================================================================== */

/* Universal Reset & M3 Typography */
* {
    font-family: "Google Sans Flex", "Google Sans", sans-serif;
    font-size: 11.5pt;
    font-weight: 400;
    outline: none;
    text-decoration: none;
    -qt-style-features: background-color;
}

/* Base Window Surface (M3 Surface) */
QMainWindow,
DolphinMainWindow {
    background-color: #141317;
    border: none;
}

/* Top App Bar (64dp M3 App Bar) */
QToolBar {
    background-color: #141317;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    spacing: 10px;
    padding: 10px 18px;
    min-height: 52px;
}

/* Action Icon Buttons (40dp M3 Circular Targets) */
QToolBar QToolButton {
    background-color: transparent;
    color: #e5e1e7;
    border: none;
    border-radius: 20px;
    min-width: 40px;
    min-height: 40px;
    padding: 4px;
    margin: 1px;
    font-weight: 500;
}

QToolBar QToolButton:hover {
    background-color: #2b2930;
    color: #ffffff;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: #474355;
    color: #c6bfff;
}

/* Search Bar & Breadcrumb Navigator (M3 Search Pill Shape) */
KUrlNavigator,
#urlNavigator {
    background-color: #211f26;
    border: none;
    border-radius: 24px;
    padding: 4px 16px;
    margin: 2px 8px;
    min-height: 44px;
}

KUrlNavigator QToolButton,
#urlNavigator QToolButton {
    background-color: transparent;
    color: #e5e1e7;
    border: none;
    border-radius: 14px;
    padding: 6px 12px;
    font-weight: 500;
    font-size: 11pt;
}

KUrlNavigator QToolButton:hover,
#urlNavigator QToolButton:hover {
    background-color: #36343b;
    color: #ffffff;
}

KUrlNavigator QToolButton:pressed,
#urlNavigator QToolButton:pressed {
    background-color: #474355;
    color: #c6bfff;
}

/* M3 Navigation Drawer (Sidebar / Places Dock) */
QDockWidget {
    border: none;
    background-color: #1c1b1f;
}

QDockWidget::title {
    background-color: #1c1b1f;
    padding: 14px 22px 6px 22px;
    color: #928f9a;
    font-size: 9.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    border: none;
}

/* Places View (QTreeView) */
QTreeView {
    background-color: #1c1b1f;
    border: none;
    padding: 8px 4px;
    show-decoration-selected: 1;
}

/* Navigation Drawer Items: 48dp M3 Pill Shape */
QTreeView::item {
    min-height: 46px;
    height: 46px;
    border-radius: 23px;
    margin: 3px 12px;
    padding-left: 16px;
    padding-right: 16px;
    color: #cac4d0;
    font-size: 11.5pt;
    font-weight: 500;
    border: none;
    text-decoration: none;
}

QTreeView::item:hover {
    background-color: #2b2930;
    color: #e5e1e7;
    text-decoration: none;
}

/* Active Navigation Pill (M3 Secondary Container Active Indicator) */
QTreeView::item:selected {
    background-color: #474355;
    color: #e8def8;
    font-weight: 600;
    text-decoration: none;
}

QTreeView::item:selected:hover {
    background-color: #534e62;
    color: #ffffff;
    text-decoration: none;
}

/* Main File Content View */
DolphinViewContainer,
DolphinView,
QAbstractItemView {
    background-color: #141317;
    border: none;
    padding: 12px;
    outline: none;
}

/* M3 Item Bubble Cards in Content View */
QAbstractItemView::item {
    border: none;
    outline: none;
    border-radius: 16px;
    padding: 8px;
    color: #e5e1e7;
}

QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
}

QAbstractItemView::item:selected {
    background-color: rgba(198, 191, 255, 0.22);
    color: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(198, 191, 255, 0.4);
}

/* M3 Tab Bar (Secondary Tabs) */
QTabBar {
    background-color: #141317;
    border: none;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #211f26;
    color: #cac4d0;
    border-radius: 18px;
    padding: 8px 20px;
    margin: 4px;
    font-weight: 500;
    font-size: 11pt;
    border: none;
}

QTabBar::tab:selected {
    background-color: #474355;
    color: #e8def8;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #2b2930;
    color: #e5e1e7;
}

/* Floating M3 Scrollbars (Thin Pill, No Track Wireframes) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #49454f;
    border-radius: 4px;
    min-height: 32px;
}

QScrollBar::handle:vertical:hover {
    background: #c6bfff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #49454f;
    border-radius: 4px;
    min-width: 32px;
}

QScrollBar::handle:horizontal:hover {
    background: #c6bfff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0px;
}

/* Splitter: Borderless Connection */
QSplitter::handle {
    background: transparent;
    width: 2px;
}

/* Elevated M3 Context Menus */
QMenu {
    background-color: #211f26;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 8px;
}

QMenu::item {
    background-color: transparent;
    color: #e5e1e7;
    border-radius: 12px;
    padding: 8px 16px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: #36343b;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 4px 8px;
}

/* Inputs & Filter Search */
QLineEdit {
    background-color: #211f26;
    color: #e5e1e7;
    border-radius: 20px;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 11pt;
}

QLineEdit:focus {
    border: 2px solid #c6bfff;
    background-color: #2b2930;
}
