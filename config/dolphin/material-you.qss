/* ===================================================================
 * Material You 3 (M3) Stylesheet for KDE Dolphin File Manager
 * Strictly following Google Material 3 Guidelines:
 * - Bubble shape geometry (Pill / 20-24px radii)
 * - Tonal surface hierarchy (Surface, Surface Container Low/High)
 * - Zero wireframe box outlines
 * - Typography: Google Sans Flex
 * =================================================================== */

/* Universal Reset & Typography */
* {
    font-family: "Google Sans Flex", "Google Sans", sans-serif;
    font-size: 11pt;
    outline: none;
    text-decoration: none;
    -qt-style-features: background-color;
}

/* Base Window Surfaces */
QMainWindow,
DolphinMainWindow {
    background-color: #141317;
    border: none;
}

/* ToolBar / Top App Bar */
QToolBar {
    background-color: #141317;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    spacing: 8px;
    padding: 8px 14px;
}

/* Action Icon Buttons (M3 Circular Icon Buttons) */
QToolBar QToolButton {
    background-color: transparent;
    color: #e5e1e7;
    border: none;
    border-radius: 18px;
    min-width: 36px;
    min-height: 36px;
    padding: 4px;
    margin: 1px;
    font-weight: 500;
}

QToolBar QToolButton:hover {
    background-color: #2b2930;
    color: #ffffff;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background-color: #474355;
    color: #c6bfff;
}

/* Breadcrumb & Path Navigator (M3 Search Pill Shape) */
KUrlNavigator,
#urlNavigator {
    background-color: #201f24;
    border: none;
    border-radius: 20px;
    padding: 3px 12px;
    margin: 2px 6px;
    min-height: 36px;
}

KUrlNavigator QToolButton,
#urlNavigator QToolButton {
    background-color: transparent;
    color: #e5e1e7;
    border: none;
    border-radius: 12px;
    padding: 4px 10px;
    font-weight: 500;
}

KUrlNavigator QToolButton:hover,
#urlNavigator QToolButton:hover {
    background-color: #36343b;
    color: #ffffff;
}

KUrlNavigator QToolButton:pressed,
#urlNavigator QToolButton:pressed {
    background-color: #474355;
    color: #c6bfff;
}

/* Navigation Drawer / Places Panel */
QDockWidget {
    border: none;
    background-color: #1c1b1f;
}

QDockWidget::title {
    background-color: #1c1b1f;
    padding: 10px 18px;
    color: #928f9a;
    font-size: 9.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
}

/* Places View (QTreeView) */
QTreeView {
    background-color: #1c1b1f;
    border: none;
    padding: 8px 4px;
    show-decoration-selected: 1;
}

/* Navigation Drawer Items: Pill Shape */
QTreeView::item {
    min-height: 40px;
    height: 40px;
    border-radius: 20px;
    margin: 2px 8px;
    padding-left: 14px;
    padding-right: 14px;
    color: #cac4d0;
    font-weight: 500;
    border: none;
    text-decoration: none;
}

QTreeView::item:hover {
    background-color: #2b2930;
    color: #e5e1e7;
    text-decoration: none;
}

/* Active Navigation Pill (M3 Secondary Container) */
QTreeView::item:selected {
    background-color: #474355;
    color: #e8def8;
    font-weight: 600;
    text-decoration: none;
}

QTreeView::item:selected:hover {
    background-color: #534e62;
    color: #ffffff;
    text-decoration: none;
}

/* Main File Content View */
DolphinViewContainer,
DolphinView,
QAbstractItemView {
    background-color: #141317;
    border: none;
}

/* M3 Tab Bar (Secondary Tabs) */
QTabBar {
    background-color: #141317;
    border: none;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: #201f24;
    color: #cac4d0;
    border-radius: 16px;
    padding: 6px 18px;
    margin: 4px;
    font-weight: 500;
    border: none;
}

QTabBar::tab:selected {
    background-color: #474355;
    color: #e8def8;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    background-color: #2b2930;
    color: #e5e1e7;
}

/* M3 Floating Scrollbars (Thin capsule, zero track border) */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #49454f;
    border-radius: 3px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #c6bfff;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
    border: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 2px 4px;
}

QScrollBar::handle:horizontal {
    background: #49454f;
    border-radius: 3px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #c6bfff;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
    border: none;
    width: 0px;
}

/* Splitters: Zero thickness */
QSplitter::handle {
    background: transparent;
    width: 2px;
}

/* Context Menus: Elevated M3 Popups */
QMenu {
    background-color: #211f26;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    color: #e5e1e7;
    border-radius: 10px;
    padding: 8px 16px;
    margin: 2px 4px;
}

QMenu::item:selected {
    background-color: #36343b;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin: 4px 8px;
}

/* Inputs & Filter / Search Bar */
QLineEdit {
    background-color: #201f24;
    color: #e5e1e7;
    border-radius: 18px;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QLineEdit:focus {
    border: 2px solid #c6bfff;
    background-color: #2b2930;
}
